# Application Configuration
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-this-in-production-use-strong-secret-key

# API Configuration
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./database/infra_telemetry.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/infra_predict_ai
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# External API Integration
PAIMANA_API_ENDPOINT=
PAIMANA_API_KEY=
PAIMANA_SYNC_ENABLED=false

# File Upload
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=csv,xlsx,xls,json
UPLOAD_DIR=./data/uploads

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Machine Learning
ML_MODEL_DIR=./models
ML_CACHE_PREDICTIONS=true

# Workers (Optional)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Request Handling
REQUEST_TIMEOUT=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
ENABLE_METRICS=true
SENTRY_DSN=
